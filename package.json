{
  "name": "meadowlark",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-fonts.mjs",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "mcp": "node --disable-warning=ExperimentalWarning server/mcp.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
